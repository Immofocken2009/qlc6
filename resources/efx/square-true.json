{
  "schema": 1,
  "id": "square-true",
  "name": "Square (true)",
  "version": 1,
  "description": "Jumps between the four corners",
  "channels": [
    {
      "target": "pan",
      "expr": "if(theta/(pi/2) < 2, 1, -1)"
    },
    {
      "target": "tilt",
      "expr": "if(theta/(pi/2) < 1, 1, if(theta/(pi/2) < 3, -1, 1))"
    }
  ]
}
